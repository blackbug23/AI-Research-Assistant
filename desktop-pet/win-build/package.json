{
  "name": "desktop-pet",
  "version": "1.0.0",
  "description": "QR码扫描入库桌面宠物",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node __tests__/test_all.js",
    "qr-test": "node simple_test.js",
    "build": "electron-packager . desktop-pet --platform=linux --arch=x64 --out=dist",
    "build:win": "electron-builder --win",
    "windows-build": "node build-windows.js"
  },
  "keywords": [
    "qr",
    "inventory",
    "desktop",
    "pet",
    "electron"
  ],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "axios": "^1.7.2",
    "pdfkit": "^0.14.0",
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "electron": "^29.0.0",
    "electron-builder": "^24.6.4"
  },
  "build": {
    "appId": "com.blackbug23.desktop-pet",
    "productName": "桌面宠物",
    "directories": {
      "output": "dist"
    },
    "files": [
      "app.js",
      "main.js",
      "src/**/*",
      "simple_main.js",
      "preload.js",
      "index.html",
      "package.json",
      "assets/**/*",
      "README.md",
      "WINDOWS_INSTALL.md"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "extraResources": [
      {
        "from": "assets",
        "to": "assets"
      }
    ]
  }
}