# LLM服务配置
LLM_URL=http://localhost:8000
LLM_TEMPERATURE=0.7
LLM_MODEL=glm-5

# 数据库配置
DATABASE_PATH=./database.db
SQLITE_MODE=memory

# 库存配置
INVENTORY_THRESHOLD=10
REMINDER_INTERVAL=15

# PDF配置
PDF_OUTPUT_PATH=./output
PDF_TEMPLATE_PATH=./templates/eln_template.json

# 桌宠配置
PET_ANIMATION_SPEED=normal
PET_COLOR=4CAF50
PET_SIZE=150

# 提醒配置
LOCATION_REMINDER_DELAY=15  # 分钟
STOCK_REMINDER_DELAY=10     # 分钟

# 扫码配置
SCAN_METHOD=camera
SCAN_TIMEOUT=3000

# 实验记录配置
EXPERIMENT_TEMPLATE=default
EXPERIMENT_AUTO_GENERATE=true