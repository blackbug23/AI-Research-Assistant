# LLM配置
LLM_API_URL=http://localhost:11434/api/generate
LLM_MODEL=llama2
LLM_TEMPERATURE=0.3

# 数据库配置
DATABASE_PATH=./desktop-pet.db

# PDF输出配置
PDF_OUTPUT_PATH=./output
PDF_FONT_PATH=./fonts/default.ttf

# 扫码配置
QR_SCAN_API_URL=http://localhost:3000/api/scan

# 语音配置（预留接口）
VOICE_API_URL=http://localhost:4000/api/voice

# 库存警戒线
STOCK_MIN_WARNING=50